{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ayoubbokkk-almoratab-api.hf.space/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
